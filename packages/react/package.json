{
  "name": "@janus/react",
  "version": "0.0.0-dev",
  "description": "Janus runtime umbrella for app code",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylemichaelsullivan/janus.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kylemichaelsullivan/janus#readme",
  "bugs": "https://github.com/kylemichaelsullivan/janus/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@janus/headless": "workspace:*",
    "@janus/primitives": "workspace:*",
    "@janus/router": "workspace:*",
    "@janus/style": "workspace:*",
    "@janus/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
