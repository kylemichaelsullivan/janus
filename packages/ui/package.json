{
  "name": "@janus/ui",
  "version": "0.0.0-dev",
  "description": "ShadCN-style Janus composed layers",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry.json": "./src/registry.json"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@janus/headless": "workspace:*",
    "@janus/primitives": "workspace:*",
    "@janus/style": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
