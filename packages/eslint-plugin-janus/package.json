{
  "name": "eslint-plugin-janus",
  "version": "0.0.0-dev",
  "description": "ESLint plugin enforcing Janus composition rules",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@janus/core": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
